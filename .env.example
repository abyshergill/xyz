# Copy this file to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=98765432123456789
DEBUG=False
DJANGO_ALLOWED_HOSTS=yourtrolley.example.com,www.yourtrolley.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourtrolley.example.com,https://www.yourtrolley.example.com
DJANGO_TIME_ZONE=UTC
DJANGO_SITE_BASE_URL=https://yourtrolley.example.com

# --- PostgreSQL ---
# Set DJANGO_USE_POSTGRES=True to switch settings.py from SQLite to
# PostgreSQL (no code changes needed). docker-compose.yml sets this
# automatically for the "app" service -- for a non-Docker deployment,
# set it here yourself.
DJANGO_USE_POSTGRES=False
DJANGO_DB_NAME=yourtrolley
DJANGO_DB_USER=yourtrolley_app
DJANGO_DB_PASSWORD=Yourtrolley1436@#
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=prefer

# --- Email (order confirmations, password resets) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.yourprovider.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=no-reply@yourtrolley.example.com
DJANGO_EMAIL_HOST_PASSWORD=change-me
DJANGO_DEFAULT_FROM_EMAIL=no-reply@yourtrolley.example.com

DJANGO_SECURE_SSL_REDIRECT=True
